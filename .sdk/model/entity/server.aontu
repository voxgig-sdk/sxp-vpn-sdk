# Entity: server

main: kit: entity: server: {

  alias: field: {}

  fields: [
    {
      name: "country"
      req: false
      type: "`$STRING`"
    }
    {
      name: "host"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "load"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "port"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "protocol"
      req: false
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "server"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api1.php"
          parts: [
            "api1.php"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
